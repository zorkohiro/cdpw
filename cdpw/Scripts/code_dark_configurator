#rowvar = add_section_label("DICOM PARAMETERS", rowvar)
#port_entry, rowvar = add_label_entry("Listening Port", aetp_data[PT], rowvar, 16)
#aet_entry, rowvar = add_label_entry("AET", aetp_data[AE], rowvar, 16)
#rowvar = rowvar + 1
#rowvar = add_label("============================================================", rowvar, 0)
