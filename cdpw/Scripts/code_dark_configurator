""" Begin Main Code section """

class TopWindow(Gtk.ApplicationWindow):
    def __init__(self, **kargs):
        super().__init__(**kargs, title="TopWindow")

        self.set_title("Code Dark Configurator")

        topbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.set_child(topbox)

        """ DICOM parameters """
        line = 0
        frame = Gtk.Frame(label="DICOM PARAMETERS")
        topbox.append(frame)
        grid = Gtk.Grid()
        frame.set_child(grid)

        label = Gtk.Label(label="Listening Port")
        label.props.xalign = 0.0
        label.props.yalign = 0.5
        grid.attach(label, 0, line, 1, 1)
        self.pt_entry = Gtk.Entry(text=str(aetp_data[PT]))
        grid.attach(self.pt_entry, 1, line, 1, 1)
        line = line + 1

        label = Gtk.Label(label="AET")
        label.props.xalign = 0.0
        label.props.yalign = 0.5
        grid.attach(label, 0, line, 1, 1)
        self.ae_entry = Gtk.Entry(text=aetp_data[AE])
        grid.attach(self.ae_entry, 1, line, 1, 1)
        line = line + 1

        """ Authorized Physician List """
        frame = Gtk.Frame(label="AUTHORIZED RADIOLOGISTS")
        topbox.append(frame)
        grid = Gtk.Grid()
        frame.set_child(grid)

        line = 1
        label = Gtk.Label(label="Edit List (this is a comma separated list so do not use any commas in names)")
        label.props.xalign = 0.0
        label.props.yalign = 0.0
        grid.attach(label, 0, line, 1, 1)
        line = line + 1

        # Create the Textbuffer and load with data
        self.buffer = Gtk.TextBuffer()
        plist = json_data[PH]
        self.buffer.set_text(', '.join(plist))

        # Create the TextView (displays the data)
        self.textview = Gtk.TextView(buffer=self.buffer)
        self.textview.set_wrap_mode(Gtk.WrapMode.WORD) # Enable text wrapping
        self.textview.set_editable(True)
        
        # Add to ScrolledWindow for scrolling capability
        scrolled_window = Gtk.ScrolledWindow()
        scrolled_window.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.ALWAYS)
        scrolled_window.set_has_frame(True)
        scrolled_window.set_child(self.textview)
        grid.attach(scrolled_window, 0, line, 1, 1)

        """ Save and Quit button """
        line = 0
        frame = Gtk.Frame(label=None)
        topbox.append(frame)
        grid = Gtk.Grid()
        frame.set_child(grid)

        button = Gtk.Button(label="Save and Quit")
        grid.attach(button, 0, line, 1, 1)
        button.connect('clicked', self.save_n_exit)
        line = line + 1

    def save_n_exit(self, button):
        """ Non-json configuration items """
        """ None any more """
        """ Changed configuration items """
        aetp_changed = False
        port = int(self.pt_entry.get_text())
        if aetp_data[PT] != port:
            aetp_data[PT] = port
            aetp_changed = True

        aet = self.ae_entry.get_text()
        if aetp_data[AE] != aet:
            aetp_data[AE] = aet
            aetp_changed = True

        json_changed = False
        si = self.buffer.get_start_iter()
        ei = self.buffer.get_end_iter()
        pboxstr = self.buffer.get_text(si, ei, False)
        newp = [x.strip() for x in pboxstr.split(",")]
        if json_data[PH] != newp:
            json_data[PH] = newp
            json_changed = True

        if aetp_changed:
            with open(aetpfile, "w") as ofile:
                json.dump(aetp_data, ofile, indent=2)
                print("", file=ofile)
            try:
                result = subprocess.run(["/usr/bin/sudo", "-n", "systemctl", "restart", "orthanc"], capture_output=True, text=True)
                if result.returncode != 0:
                    print("Error Restarting Orthanc", result.stderr)
            except subprocess.CalledProcessError as e:
                print("Error restarting Orthanc", e.output)

        if json_changed:
            with open(jsonfile, "w") as ofile:
                json.dump(json_data, ofile, indent=2)
                print("", file=ofile)
                print("Other configuration data has changed. Restart any currently open report editing sessions.")
        exit(0)
        
def top_on_activate(app):
    win = TopWindow(application=app) 
    win.present()

app = Gtk.Application(application_id="org.github.zorkohiro.cdpw.code_dark_study_tool.top")
app.connect("activate", top_on_activate)
app.run(None)
